show pdbs;
ALTER SYSTEM SET PROCESSES=500 SCOPE=SPFILE;
alter session set container= freepdb1;
create user magicstudio identified by magicstudio DEFAULT TABLESPACE users quota unlimited on users;
grant DB_DEVELOPER_ROLE to magicstudio;

BEGIN
CTX_DDL.CREATE_PREFERENCE('magicstudio.world_lexer','WORLD_LEXER');
END;
/
